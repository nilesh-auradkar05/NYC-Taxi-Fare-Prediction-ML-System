# NYC Taxi - Training Base Image

# BUILD: docker build -f Dockerfile.Training -t nyc-taxi-training .

FROM python:3.12-slim AS builder

WORKDIR /build

RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc g++ && \
    rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements-training.txt .
RUN pip install --no-cache-dir -r requirements-training.txt

FROM python:3.12-slim

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Shared feature engineering module
COPY src/common/__init__.py src/common/__init__.py
COPY src/common/features.py src/common/features.py

ENV PYTHONPATH="/app/src:${PYTHONPATH}"